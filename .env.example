# ====================================================================
# CodeMentorAI - Environment Variables Configuration
# Copy this file to .env and replace the values with your credentials
# ====================================================================

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://username:password@aws-0-region.pooler.supabase.com:6543/postgres

# Groq API Configuration (Fast AI Inference with Qwen)
# Obtain a free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Session Security (Required for Express session encryption)
SESSION_SECRET=your_super_secret_session_key_here

# Application Configuration
PORT=5000
NODE_ENV=development
